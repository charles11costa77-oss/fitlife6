name: Build AAB
on:
  push:
    branches: [main]
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-node@v3
        with:
          node-version: 18
      - run: npm install -g @bubblewrap/cli
      - run: |
          mkdir -p twa
          cp twa-manifest.json twa/twa-manifest.json 
          cd twa
          bubblewrap update
          bubblewrap build
      - uses: actions/upload-artifact@v3
        with:
          name: fitlife6-aab
          path: twa/app/build/outputs/bundle/release/*.aab
